    {
      "name": "Sleep Reports",
      "item": [
        {
          "name": "List Sleep Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SleepMeAPI_Url}}/sleep-reports/?days_back={{days_back}}&time_zone={{time_zone}}",
              "host": [
                "{{SleepMeAPI_Url}}"
              ],
              "path": [
                "sleep-reports",
                ""
              ],
              "query": [
                {
                  "key": "start_date",
                  "value": "{{start_date}}",
                  "disabled": true,
                  "description": "Optional YYYY-MM-DD date. Disabled to use the API current-date default; set start_date and enable to select a date."
                },
                {
                  "key": "days_back",
                  "value": "{{days_back}}",
                  "description": "0 through 6. Set 6 for a week including the selected date."
                },
                {
                  "key": "time_zone",
                  "value": "{{time_zone}}",
                  "description": "IANA time zone name; API default UTC when omitted."
                }
              ]
            },
            "description": "Reads durations, sleep scores, sessions, and hypnogram data for the selected date range. The default collection days_back is 6. start_date is optional and disabled by default.\n\nReference: https://docs.developer.sleep.me/api/"
          },
          "response": []
        },
        {
          "name": "Get Today Sleep Reports",
          "response": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SleepMeAPI_Url}}/sleep-reports/?days_back=0&time_zone={{time_zone}}",
              "host": [
                "{{SleepMeAPI_Url}}"
              ],
              "path": [
                "sleep-reports",
                ""
              ],
              "query": [
                {
                  "key": "start_date",
                  "value": "{{start_date}}",
                  "disabled": true,
                  "description": "Optional YYYY-MM-DD date. Disabled to use the API current-date default; set start_date and enable to select a date."
                },
                {
                  "key": "days_back",
                  "value": "0",
                  "description": "0 through 6. Set 6 for a week including the selected date."
                },
                {
                  "key": "time_zone",
                  "value": "{{time_zone}}",
                  "description": "IANA time zone name; API default UTC when omitted."
                }
              ]
            },
            "description": "Reads today\u2019s sleep reports in time_zone using days_back=0 and the API current-date default. Enable start_date to read one specific day.\n\nReference: https://docs.developer.sleep.me/api/"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{SleepMeAPI_Token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "SleepMeAPI_Url",
      "value": "https://api.developer.sleep.me/v1",
      "type": "string",
      "description": "Base URL, without a trailing slash."
    },
    {
      "key": "SleepMeAPI_Token",
      "value": "",
      "type": "string",
      "description": "Set your Sleepme developer bearer token in a private environment."
    },
    {
      "key": "device_id",
      "value": "",
      "type": "string",
      "description": "Set a claimed device ID returned by List Devices."
    },
    {
      "key": "start_date",
      "value": "",
      "type": "string",
      "description": "Optional YYYY-MM-DD date. Enable the request query parameter to use it."
    },
    {
      "key": "days_back",
      "value": "6",
      "type": "string",
      "description": "0 through 6; 6 includes the last week."
    },
    {
      "key": "time_zone",
      "value": "UTC",
      "type": "string",
      "description": "IANA time zone name, for example America/Los_Angeles."
    }
  ]
}
