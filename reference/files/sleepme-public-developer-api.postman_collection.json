{
  "info": {
    "_postman_id": "4142850a-b899-4e06-aa32-1c62a934a3ff",
    "name": "Sleepme Public Developer API",
    "description": "All four operations in the Sleepme Public Developer API v1.1, plus individual PATCH recipes for every documented writable control property.\n\nSources: https://docs.developer.sleep.me/api/ and https://docs.developer.sleep.me/docs/apiexamples/. Reference checked 2026-10-05.\n\nSet SleepMeAPI_Token to your Sleepme developer token and device_id to an ID returned by List Devices. Requests inherit collection bearer authentication. SleepMeAPI_Url is the canonical base URL variable.\n\nRun individual requests using postman collection run <collection-path> -i \"Folder/Request Name\". See postman/files/sleepme-cli-commands.txt for every command. Use a private Postman environment to override the token and variables.\n\nPATCH requests change the selected device. Choose the specific recipe you want to execute. The documented limit is 10 requests per account per discrete minute; when making repeated calls, handle 429 responses with exponential backoff.\n\nSleep reports accept optional start_date (ISO8601 date, defaults to current date), days_back (0 through 6, defaults to 0), and time_zone (IANA name, defaults to UTC). The reference contains inconsistent interval wording; the collection uses the documented parameter defaults and bounds without rewriting that interval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "10847419"
  },
  "item": [
    {
      "name": "Devices",
      "item": [
        {
          "name": "List Devices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SleepMeAPI_Url}}/devices",
              "host": [
                "{{SleepMeAPI_Url}}"
              ],
              "path": [
                "devices"
              ]
            },
            "description": "Returns all claimed devices for this token, including IDs, names, and attachments.\n\nReference: https://docs.developer.sleep.me/api/"
          },
          "response": []
        },
        {
          "name": "Get Device Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SleepMeAPI_Url}}/devices/:device_id",
              "host": [
                "{{SleepMeAPI_Url}}"
              ],
              "path": [
                "devices",
                ":device_id"
              ],
              "variable": [
                {
                  "key": "device_id",
                  "value": "{{device_id}}",
                  "description": "Claimed device ID from List Devices."
                }
              ]
            },
            "description": "Reads device identity, controls, status, and model-specific properties. Dock Pro and Sleep Tracker expose different status fields.\n\nReference: https://docs.developer.sleep.me/api/"
          },
          "response": []
        },
        {
          "name": "Update Device Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SleepMeAPI_Url}}/devices/:device_id",
              "host": [
                "{{SleepMeAPI_Url}}"
              ],
              "path": [
                "devices",
                ":device_id"
              ],
              "variable": [
                {
                  "key": "device_id",
                  "value": "{{device_id}}",
                  "description": "Claimed device ID from List Devices."
                }
              ]
            },
            "description": "Updates one or more Dock Pro controls. This preserved recipe sets 69 F and standby. All control fields are optional; send only the fields you want to change. Send control properties at the top level, without a control wrapper.\n\nReference: https://docs.developer.sleep.me/api/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"set_temperature_f\": 69,\n  \"thermal_control_status\": \"standby\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Turn Device On",
          "response": [],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SleepMeAPI_Url}}/devices/:device_id",
              "host": [
                "{{SleepMeAPI_Url}}"
              ],
              "path": [
                "devices",
                ":device_id"
              ],
              "variable": [
                {
                  "key": "device_id",
                  "value": "{{device_id}}",
                  "description": "Claimed device ID from List Devices."
                }
              ]
            },
            "description": "Starts the thermal control systems. This changes the selected Dock Pro device.\n\nReference: https://docs.developer.sleep.me/api/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"thermal_control_status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Turn Device Off",
          "response": [],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SleepMeAPI_Url}}/devices/:device_id",
              "host": [
                "{{SleepMeAPI_Url}}"
              ],
              "path": [
                "devices",
                ":device_id"
              ],
              "variable": [
                {
                  "key": "device_id",
                  "value": "{{device_id}}",
                  "description": "Claimed device ID from List Devices."
                }
              ]
            },
            "description": "Stops the thermal control systems. This changes the selected Dock Pro device.\n\nReference: https://docs.developer.sleep.me/api/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"thermal_control_status\": \"standby\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
